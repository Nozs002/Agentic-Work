{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agenticwork.io/schemas/specialist-result.schema.json",
  "title": "SpecialistResultContract",
  "description": "Phong bì Vận chuyển Hạ tầng (Transport Envelope) do Agent Output Adapter đóng gói từ Domain Model để gửi tới Gateway 2 & Action Agent",
  "type": "object",
  "allOf": [
    {
      "$ref": "base-contract.schema.json"
    }
  ],
  "required": [
    "resultId",
    "taskId",
    "specialistRole",
    "executionType"
  ],
  "properties": {
    "traceId": {},
    "workflowId": {},
    "timestamp": {},
    "fromAgent": {},
    "toAgent": {},
    "contractType": {
      "const": "SPECIALIST_RESULT"
    },
    "resultId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "specialistRole": {
      "type": "string",
      "enum": [
        "BA_AGENT",
        "ARCHITECT_AGENT",
        "CODER_AGENT",
        "DATABASE_AGENT",
        "TESTER_AGENT"
      ]
    },
    "executionType": {
      "type": "string",
      "enum": [
        "FILE_CREATE",
        "FILE_MODIFY",
        "FILE_DELETE",
        "CHAT_RESPONSE"
      ],
      "description": "Loại hành động đầu ra hạ tầng đề xuất"
    },
    "domainPayload": {
      "type": "object",
      "description": "Dữ liệu Domain Model gốc thuần túy do Skill/Agent sinh ra (RequirementAnalysis, GeneratedCode, TestPlan...)"
    },
    "proposedPayload": {
      "type": "array",
      "description": "Dữ liệu thao tác file/đĩa đã qua Agent Output Adapter chuyển đổi từ domainPayload",
      "items": {
        "type": "object",
        "required": [
          "targetPath"
        ],
        "properties": {
          "targetPath": {
            "type": "string",
            "description": "Đường dẫn file mục tiêu"
          },
          "content": {
            "type": "string",
            "description": "Nội dung file đầy đủ nếu CREATE hoặc thay đổi hoàn toàn"
          },
          "replacementChunk": {
            "type": "object",
            "required": [
              "startLine",
              "endLine",
              "targetContent",
              "replacementContent"
            ],
            "properties": {
              "startLine": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              },
              "targetContent": {
                "type": "string"
              },
              "replacementContent": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "chatMessage": {
      "type": "string",
      "description": "Nội dung phản hồi trực tiếp cho người dùng nếu executionType là CHAT_RESPONSE"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "skillUsed": {
          "type": "string"
        },
        "affectedModules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}