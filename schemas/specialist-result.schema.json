{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agenticwork.io/schemas/specialist-result.schema.json",
  "title": "SpecialistResultContract",
  "description": "Phong bì Đầu ra Chuẩn hóa (Output Envelope) do Specialist Agents sinh ra trong RAM gửi tới GW2",
  "type": "object",
  "required": ["traceId", "resultId", "taskId", "specialistRole", "executionType"],
  "properties": {
    "traceId": {
      "type": "string",
      "description": "Mã định danh vết (Trace ID) đại diện xuyên suốt 1 vòng đời request"
    },
    "resultId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "specialistRole": {
      "type": "string",
      "enum": ["BA_AGENT", "ARCHITECT_AGENT", "CODER_AGENT", "DATABASE_AGENT", "TESTER_AGENT"]
    },
    "executionType": {
      "type": "string",
      "enum": ["FILE_CREATE", "FILE_MODIFY", "FILE_DELETE", "CHAT_RESPONSE", "STRUCTURED_RESULT", "DOMAIN_RESULT"],
      "description": "Loại hành động đầu ra đề xuất"
    },
    "proposedPayload": {
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [
          {
            "title": "FileActionPayload",
            "required": ["targetPath"],
            "properties": {
              "targetPath": {
                "type": "string",
                "description": "Đường dẫn file mục tiêu"
              },
              "content": {
                "type": "string",
                "description": "Nội dung file đầy đủ nếu CREATE hoặc thay đổi hoàn toàn (Bắt buộc escape JSON hợp lệ: \\n, \\\")"
              },
              "replacementChunk": {
                "type": "object",
                "required": ["searchString", "replaceString"],
                "properties": {
                  "searchString": {
                    "type": "string",
                    "description": "Đoạn văn bản/code cũ cần tìm kiếm trong file (Bắt buộc escape JSON hợp lệ: \\n, \\\")"
                  },
                  "replaceString": {
                    "type": "string",
                    "description": "Đoạn văn bản/code mới dùng để thay thế (Bắt buộc escape JSON hợp lệ: \\n, \\\")"
                  }
                }
              }
            }
          },
          {
            "title": "GenericDomainPayload",
            "required": ["payloadType", "payload"],
            "properties": {
              "payloadType": {
                "type": "string",
                "description": "Loại domain payload (Ví dụ: RequirementsInterview, GapAnalysis, RiskAssessment...)"
              },
              "payload": {
                "type": "object",
                "description": "Dữ liệu nghiệp vụ cấu trúc chi tiết"
              }
            }
          }
        ]
      }
    },
    "chatMessage": {
      "type": "string",
      "description": "Nội dung phản hồi trực tiếp cho người dùng"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "skillUsed": { "type": "string" },
        "affectedModules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "READY_FOR_REVIEW", "READY_FOR_COMMIT", "COMPLETED"],
          "description": "Trạng thái vòng đời của kết quả"
        },
        "version": {
          "type": "integer",
          "description": "Phiên bản dữ liệu"
        },
        "readinessScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Điểm % độ sẵn sàng hoàn thành (0-100)"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Mức độ tự tin về tính chính xác (0.0-1.0)"
        },
        "missingFields": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Danh sách các trường/tầng thông tin còn thiếu"
        },
        "interviewProgress": {
          "type": "object",
          "properties": {
            "progressPercent": { "type": "number" },
            "completedPhases": { "type": "array", "items": { "type": "string" } },
            "pendingPhases": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
