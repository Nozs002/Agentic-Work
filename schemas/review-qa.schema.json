{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agenticwork.io/schemas/review-qa.schema.json",
  "title": "ReviewQAContract",
  "description": "Hợp đồng Dữ liệu Kết quả Kiểm định Hậu thực thi (Gateway 2 Review QA)",
  "type": "object",
  "required": ["traceId", "reviewId", "resultId", "timestamp", "status"],
  "properties": {
    "traceId": {
      "type": "string",
      "description": "Mã định danh vết (Trace ID) đại diện xuyên suốt 1 vòng đời request"
    },
    "reviewId": {
      "type": "string"
    },
    "resultId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["PASSED", "FAILED"],
      "description": "Trạng thái kiểm tra sau sinh code/spec"
    },
    "qaSignature": {
      "type": "string",
      "description": "Chữ ký mã hóa xác nhận đã vượt qua GW2 (Bắt buộc để Action Agent thực thi)"
    },
    "feedback": {
      "type": "object",
      "description": "Cung cấp chi tiết lỗi nếu FAILED để kích hoạt Retry Loop",
      "properties": {
        "linterErrors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "syntaxErrors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "businessRuleViolations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggestedFix": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
