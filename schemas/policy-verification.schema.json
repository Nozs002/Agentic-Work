{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agenticwork.io/schemas/policy-verification.schema.json",
  "title": "PolicyVerificationContract",
  "description": "Hợp đồng Dữ liệu Kết quả Kiểm duyệt Chính sách Tiền thực thi (Gateway 1 Policy Engine)",
  "type": "object",
  "allOf": [
    { "$ref": "base-contract.schema.json" }
  ],
  "required": ["verificationId", "dagId", "status", "conflicts"],
  "properties": {
    "traceId": {
      "type": "string",
      "description": "Mã định danh vết (Trace ID) đại diện xuyên suốt 1 vòng đời request"
    },
    "workflowId": {
      "type": "string",
      "description": "Mã định danh luồng công việc cụ thể"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "fromAgent": {
      "type": "string",
      "description": "Định danh Agent phát tạo gói tin"
    },
    "toAgent": {
      "type": "string",
      "description": "Định danh Agent đích nhận gói tin"
    },
    "contractType": {
      "type": "string",
      "description": "Loại Hợp đồng Dữ liệu (POLICY_VERIFICATION)"
    },
    "verificationId": {
      "type": "string"
    },
    "dagId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["APPROVED", "CONFLICT_DETECTED", "REJECTED"],
      "description": "Trạng thái kiểm duyệt tiền thực thi"
    },
    "requireHumanApproval": {
      "type": "boolean",
      "description": "Nếu true, phải chờ nút Approve trên Web Dashboard"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "ruleTitle", "severity", "reason"],
        "properties": {
          "ruleId": {
            "type": "string"
          },
          "ruleTitle": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "INFO"]
          },
          "reason": {
            "type": "string",
            "description": "Lý do prompt/task mâu thuẫn với luật nghiệp vụ"
          },
          "suggestedResolution": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
