{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agenticwork.io/schemas/task-dag.schema.json",
  "title": "TaskDAGContract",
  "description": "Hợp đồng Dữ liệu Đồ thị Công việc (Task DAG) do Planner Agent rã từ Prompt người dùng",
  "type": "object",
  "allOf": [
    {
      "$ref": "base-contract.schema.json"
    }
  ],
  "required": [
    "dagId",
    "intentCategory",
    "tasks"
  ],
  "properties": {
    "traceId": {},
    "workflowId": {},
    "timestamp": {},
    "fromAgent": {},
    "toAgent": {},
    "contractType": {
      "const": "TASK_DAG"
    },
    "dagId": {
      "type": "string",
      "description": "Mã định danh duy nhất của Task DAG"
    },
    "userPrompt": {
      "type": "string",
      "description": "Prompt gốc của người dùng từ IDE"
    },
    "intentCategory": {
      "type": "string",
      "enum": [
        "CODE_GEN",
        "REQUIREMENTS_REFINEMENT",
        "BUG_FIX",
        "ARCHITECTURE_DESIGN",
        "DOCUMENTATION"
      ],
      "description": "Phân loại ý định chính của yêu cầu"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "taskId",
          "stepNumber",
          "description",
          "assignedRole"
        ],
        "properties": {
          "taskId": {
            "type": "string"
          },
          "stepNumber": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "assignedRole": {
            "type": "string",
            "enum": [
              "BA_AGENT",
              "ARCHITECT_AGENT",
              "CODER_AGENT",
              "DATABASE_AGENT",
              "TESTER_AGENT",
              "FILE_SYSTEM_AGENT",
              "GIT_AGENT"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Danh sách taskId phải hoàn thành trước task này"
          },
          "targetModule": {
            "type": "string",
            "description": "Phân hệ hoặc đường dẫn module mục tiêu"
          },
          "requiredSkills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Danh sách các skill (ví dụ: requirements-interview, odoo-dev) cần tiêm"
          }
        }
      }
    }
  },
  "additionalProperties": false
}